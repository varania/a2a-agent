# --- LLM (read by langchain-openai) -----------------------------------------
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=http://localhost:11434/v1   # Ollama / vLLM / LM Studio

A2A_MODEL=openai:gpt-4o-mini
A2A_TEMPERATURE=0.0
# A2A_MAX_TOKENS=1024

# --- A2A agent identity ------------------------------------------------------
A2A_AGENT_NAME=LangChain A2A Agent
A2A_AGENT_DESCRIPTION=General purpose assistant exposed through the A2A protocol.
# A2A_AGENT_VERSION=0.1.0

# --- Server ------------------------------------------------------------------
A2A_HOST=0.0.0.0
A2A_PORT=9999
# A2A_PUBLIC_URL=https://my-agent.example.com
A2A_LOG_LEVEL=INFO
A2A_STREAMING=true
# A2A_CORS_ORIGINS=["http://localhost:3000"]
